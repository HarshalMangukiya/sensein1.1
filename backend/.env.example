# SENSEIN Backend Environment Configuration Template
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://frontend-rho-steel-49.vercel.app
BACKEND_URL=https://sensein1-1.vercel.app

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Redis Cache (Optional, in-memory fallback enabled if absent)
REDIS_URL=redis://localhost:6379

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sensein?retryWrites=true&w=majority

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Mailer Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password

# Delhivery Logistics Express API
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_CLIENT_NAME=SENSEIN
DELHIVERY_PICKUP_LOCATION=your_warehouse_registered_location
DELHIVERY_ENV=production

# Pre-authorized Admin Credentials
ADMIN_EMAIL=admin@sensein.com
ADMIN_PASSWORD=your_admin_secure_password
